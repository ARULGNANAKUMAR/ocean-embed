# ──────────────────────────────────────────────────────────────
# OceanVerse AI — Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ──────────────────────────────────────────────────────────────

# ── Flask ────────────────────────────────────────────────────
# A long, random, secret string used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to "production" on a real deployment. Disables debug behavior.
FLASK_ENV=production

# ── Firebase Web SDK config (PUBLIC identifiers, not secrets) ─
# Found in Firebase Console > Project Settings > General > Your apps > Web app
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ── Firebase Admin SDK (SERVER-SIDE SECRET — never expose to frontend) ─
# Path to a service-account JSON file downloaded from
# Firebase Console > Project Settings > Service Accounts > Generate new private key.
# This file itself must NEVER be committed to git.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# ── Admin bootstrap ─────────────────────────────────────────
# The email address that is automatically granted the admin role the first
# time it signs in via Firebase Authentication. After that, role changes
# must go through the protected admin role-management endpoint.
ADMIN_EMAIL=arulgnanakumar@gmail.com
